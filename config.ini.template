[google]
# OAuth client from Google Cloud Console (APIs & Services > Credentials).
# Client type MUST be "Desktop app" — Gmail's scopes are restricted and Google
# rejects them outright on the TV/limited-input device flow, so login opens a
# browser and catches the redirect on a short-lived local server instead.
client_id     = YOUR_CLIENT_ID.apps.googleusercontent.com
client_secret = YOUR_CLIENT_SECRET

[email]
# The Gmail address you send from. Must match the account you authenticate with.
sender = your@gmail.com

[settings]
excel_path               = outreach.xlsx
log_path                 = outreach.log
token_cache_path         = token_cache.json
import_path              = latestList.xlsx
follow_up_interval_days  = 3
max_follow_ups           = 5
min_delay_seconds        = 30
max_delay_seconds        = 60
schedule_min_gap_seconds = 60
schedule_max_gap_seconds = 180
